<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <p>Role: <%= role_name %></p>

    <% if (role_name === 'admin') { %>
    <div class="dashboard-actions">
        <a href="/users">View Registered Users</a>
    </div>
    <% } %>

    <h2>My Volunteer Projects</h2>

    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul>
            <% volunteerProjects.forEach((project) => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                    <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                        <button type="submit">
                            Remove Volunteer Signup
                        </button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>You have not signed up to volunteer for any projects.</p>
    <% } %>

</main>

<%- include('partials/footer') %>

