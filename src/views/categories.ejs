<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>
    <a href="/new-category">Add New Category</a>
    <ul>

        <% categories.forEach((category) => { %>

            <li>

                <strong>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </strong>

                :
                
                <%= category.project_title %>

            </li>

        <% }) %>

    </ul>


</main>

<%- include('partials/footer') %>